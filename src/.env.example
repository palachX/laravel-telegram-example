APP_NAME=yandex-data-service
APP_ENV=local
APP_KEY=base64:07W2KBbPA+vFQSC8qyP4FoNtYUA8vK+VTzFxdBUW8zE=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
ACTIVITY_LOGGER_ENABLED=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pgdb
