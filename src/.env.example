RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=null

TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TG_URL=YOUR_TELEGRAM_BOT_URL