{
    "name": "palach/laravel-telegram",
    "type": "project",
    "description": "Laravel Telegram Example",
    "license": "proprietary",
    "require": {
        "php": "^8.3.6",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "spatie/laravel-data": "^4.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "1.16",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.1",
        "rector/rector": "^2.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
